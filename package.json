{
  "name": "touch-ctrl",
  "version": "2.0.0",
  "description": "Pointer Events でタッチ・マウス・ペンの操作をまとめて受け取る、依存ゼロの小さなライブラリ",
  "type": "module",
  "main": "dist/touch-ctrl.umd.js",
  "module": "src/touch-ctrl.js",
  "types": "touch-ctrl.d.ts",
  "exports": {
    ".": {
      "types": "./touch-ctrl.d.ts",
      "import": "./src/touch-ctrl.js",
      "require": "./dist/touch-ctrl.umd.js"
    }
  },
  "files": [
    "src",
    "dist",
    "touch-ctrl.d.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs --check && node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nzw/touch-ctrl-js.git"
  },
  "keywords": [
    "touch",
    "pointer-events",
    "gesture",
    "controller",
    "swipe"
  ],
  "author": "nzw",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nzw/touch-ctrl-js/issues"
  },
  "homepage": "https://github.com/nzw/touch-ctrl-js#readme"
}
